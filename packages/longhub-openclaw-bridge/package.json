{
  "name": "@longhub/openclaw-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw 原生工具到 LongHub Core 的可信上下文桥接插件",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "plugin:validate": "pnpm build && openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
