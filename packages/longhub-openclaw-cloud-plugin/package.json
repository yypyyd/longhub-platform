{
  "name": "@longhub/openclaw-cloud-plugin",
  "version": "0.2.1",
  "private": false,
  "description": "OpenClaw 通用 LongHub 云端 Skill Cloud API 插件",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/*.d.ts",
    "index.js",
    "openclaw.plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:openclaw/plugin-sdk/tool-plugin --sourcemap --outfile=dist/index.js",
    "artifact:pack": "pnpm build && node ./scripts/build-artifact.mjs --surface cloud-plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "plugin:validate": "pnpm build && openclaw plugins validate --entry ./index.js"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@longhub/windows-credential": "workspace:*",
    "esbuild": "0.21.5",
    "openclaw": "2026.7.1-2",
    "typebox": "1.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
