{
  "name": "longhub-desktop",
  "version": "0.8.4",
  "private": true,
  "description": "龙枢 Windows 客户端：内嵌 OpenClaw Gateway 与原生 Control UI",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "node-runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "prototype": "node dist/prototype.js",
    "start": "electron .",
    "predist": "node -e \"const fs=require('fs');fs.mkdirSync('node-runtime',{recursive:true});fs.copyFileSync(process.execPath,'node-runtime/node.exe')\"",
    "dist": "node scripts/build-windows-release.mjs --mode public",
    "predist:internal": "node -e \"const fs=require('fs');fs.mkdirSync('node-runtime',{recursive:true});fs.copyFileSync(process.execPath,'node-runtime/node.exe')\"",
    "dist:internal": "node scripts/build-windows-release.mjs --mode internal",
    "verify:release": "node scripts/release-verification.mjs --mode public",
    "verify:release:internal": "node scripts/release-verification.mjs --mode internal",
    "runtime:manifest": "node scripts/openclaw-runtime-manifest.mjs --write"
  },
  "build": {
    "appId": "cn.longhub.desktop",
    "productName": "龙枢",
    "artifactName": "LongHub-Setup-${version}.exe",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@lydell/node-pty-darwin-arm64/**/*",
      "!node_modules/@lydell/node-pty-darwin-x64/**/*",
      "!node_modules/@lydell/node-pty-linux-arm64/**/*",
      "!node_modules/@lydell/node-pty-linux-x64/**/*",
      "!node_modules/@lydell/node-pty-win32-arm64/**/*",
      "!node_modules/sqlite-vec-darwin-arm64/**/*",
      "!node_modules/sqlite-vec-darwin-x64/**/*",
      "!node_modules/sqlite-vec-linux-arm64/**/*",
      "!node_modules/sqlite-vec-linux-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "node-runtime",
        "to": "node-runtime"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/longhub-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "龙枢"
    }
  },
  "dependencies": {
    "@longhub/windows-credential": "workspace:*",
    "@longhub/api-client": "workspace:*",
    "@longhub/core": "workspace:*",
    "@longhub/feature-policy": "workspace:*",
    "@longhub/hr-suite": "workspace:*",
    "@longhub/openclaw-compat": "workspace:*",
    "@longhub/openclaw-bridge": "workspace:*",
    "@longhub/observability": "workspace:*",
    "@longhub/xiaolongxia-adapter": "workspace:*",
    "@longhub/pack-schema": "workspace:*",
    "@longhub/sdk": "workspace:*",
    "openclaw": "2026.7.1-2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "longhub-cloud-api": "workspace:*",
    "longhub-console": "workspace:*"
  }
}
