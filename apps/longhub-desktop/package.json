{
  "name": "longhub-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "龙枢工作台：Windows 客户端（Electron + React 壳）",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "prototype": "node dist/prototype.js",
    "start": "electron ."
  },
  "dependencies": {
    "@longhub/api-client": "workspace:*",
    "@longhub/core": "workspace:*",
    "@longhub/hr-suite": "workspace:*",
    "@longhub/xiaolongxia-adapter": "workspace:*",
    "@longhub/pack-schema": "workspace:*",
    "@longhub/sdk": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "longhub-cloud-api": "workspace:*",
    "longhub-console": "workspace:*"
  }
}
