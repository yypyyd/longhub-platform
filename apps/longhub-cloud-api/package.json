{
  "name": "longhub-cloud-api",
  "version": "0.1.0",
  "private": true,
  "description": "龙枢云台：模块化单体控制面 API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@longhub/observability": "workspace:*",
    "@longhub/pack-schema": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8",
    "longhub-executor": "workspace:*"
  }
}
