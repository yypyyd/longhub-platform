{
  "name": "longhub-cloud-api",
  "version": "0.1.0",
  "private": true,
  "description": "\u9f99\u67a2\u4e91\u53f0\uff1a\u6a21\u5757\u5316\u5355\u4f53\u63a7\u5236\u9762 API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:legacy": "node ./scripts/run-legacy-surface-tests.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@longhub/cloud-skill-adapter": "workspace:*",
    "@longhub/feature-policy": "workspace:*",
    "@longhub/observability": "workspace:*",
    "@longhub/pack-schema": "workspace:*",
    "longhub-executor": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
