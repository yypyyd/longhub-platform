LONGHUB_SERVER_NAME=CHANGE_ME_LONGHUB_HOST
LONGHUB_TLS_CERTIFICATE=/etc/longhub/tls/CHANGE_ME_LONGHUB_HOST.crt
LONGHUB_TLS_CERTIFICATE_KEY=/etc/longhub/tls/CHANGE_ME_LONGHUB_HOST.key
LONGHUB_CLIENT_RELEASE_DIR=/var/lib/longhub/client-releases
LONGHUB_CLOUD_PLUGIN_RELEASE_DIR=/var/lib/longhub/cloud-plugin-releases
LONGHUB_CLOUD_CLI_RELEASE_DIR=/var/lib/longhub/cloud-cli-releases
LONGHUB_CLOUD_API_UPSTREAM=127.0.0.1:8081
LONGHUB_WEB_ROOT=/var/www/longhub/current
