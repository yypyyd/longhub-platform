NODE_ENV=production
PORT=8081
CLOUD_API_BIND_HOST=127.0.0.1
DATABASE_URL='postgresql://longhub_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/longhub'
EXECUTOR_URL=http://127.0.0.1:8082
EXECUTOR_CREDENTIAL_SECRET=CHANGE_ME_SHARED_BASE64URL_SECRET
EXECUTOR_CREDENTIAL_KEY_ID=CHANGE_ME_EXECUTOR_KEY_ID
ADMIN_TOKEN=CHANGE_ME_HIGH_ENTROPY_ADMIN_TOKEN
MODEL_CONFIG_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
CORS_ALLOW_ORIGINS=https://CHANGE_ME_LONGHUB_HOST
CLIENT_RELEASE_DIR=/var/lib/longhub/client-releases
CLOUD_PLUGIN_RELEASE_DIR=/var/lib/longhub/cloud-plugin-releases
CLOUD_CLI_RELEASE_DIR=/var/lib/longhub/cloud-cli-releases
CLIENT_UPDATE_SIGNING_KEY_ID=CHANGE_ME_UPDATE_SIGNING_KEY_ID
SKILL_SIGNING_KEY_ID=CHANGE_ME_SKILL_SIGNING_KEY_ID
CLOUD_PLUGIN_SIGNING_KEY_ID=CHANGE_ME_CLOUD_PLUGIN_SIGNING_KEY_ID
CLOUD_CLI_SIGNING_KEY_ID=CHANGE_ME_CLOUD_CLI_SIGNING_KEY_ID
# Set both only for the first successful startup, then remove them immediately.
ADMIN_SEED_USERNAME=CHANGE_ME_INITIAL_ADMIN_USERNAME
ADMIN_SEED_PASSWORD=CHANGE_ME_RANDOM_INITIAL_ADMIN_PASSWORD
